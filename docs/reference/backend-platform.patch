+        "https://json-schema.org/draft/2020-12/schema"
+    )
+    view_key: str
+    purpose: Literal["edit", "summary", "print", "observer", "correction"]
+    resolved_locale: str = Field(
+        description="Locale selected by the pinned catalog, or negotiated en/fa fallback."
+    )
