{
  "openapi": "3.1.0",
  "info": {
    "title": "Frozen APP-BE-007 preferences subset",
    "version": "2026-10-09"
  },
  "paths": {
    "/api/v1/me/preferences": {
      "get": {
        "description": "Read only the authenticated user's preferences. Missing settings return typed defaults and a version-zero reference without inserting a row. No other actor identifier is accepted. Returns private, no-store JSON. Authentication and user deactivation follow existing auth rules.",
        "operationId": "read_preferences_api_v1_me_preferences_get",
        "parameters": [
          {
            "description": "Optional caller-controlled client software identifier for audit and diagnostics; captured up to 1024 characters. Browsers supply their own value and may ignore manual Swagger overrides. Not trusted client identity or authorization.",
            "in": "header",
            "name": "User-Agent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional caller-controlled client software identifier for audit and diagnostics; captured up to 1024 characters. Browsers supply their own value and may ignore manual Swagger overrides. Not trusted client identity or authorization.",
              "examples": [
                "MyNativeClient/2.3",
                "python-httpx/0.28.1"
              ],
              "title": "User-Agent"
            }
          },
          {
            "description": "Optional RFC 9110 HTTP-date generated by native clients for advisory diagnostics. Browser JavaScript cannot set Date. Missing or invalid values do not reject the request.",
            "example": "Mon, 28 Sep 2026 12:00:00 GMT",
            "in": "header",
            "name": "Date",
            "required": false,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "description": "Optional preferred response language. English and Farsi are supported; regional tags use their base language and unsupported values fall back to English.",
            "example": "fa-IR",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional UUIDv7 correlation identifier. Missing or invalid values are replaced with a generated UUIDv7; the effective value is returned in X-Request-ID.",
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional caller-supplied reason recorded in audit history. It is not an authorization credential.",
            "example": "Correcting a submitted request",
            "in": "header",
            "name": "X-Audit-Reason",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_PreferencesDTO_"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "Protected actor-specific response; persistent caching is prohibited.",
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "X-Client-Date-Advisory": {
                "description": "Present as check-device-time only when the configured apparent difference threshold is reached.",
                "schema": {
                  "enum": [
                    "check-device-time"
                  ],
                  "type": "string"
                }
              },
              "X-Client-Date-Delta-Seconds": {
                "description": "Signed server receipt minus client Date in seconds; includes transit and generation delay, so it is not exact clock skew.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Client-Date-Status": {
                "description": "Optional client Date reading: available, unavailable, or invalid. No request is rejected for this diagnostic.",
                "schema": {
                  "enum": [
                    "available",
                    "unavailable",
                    "invalid"
                  ],
                  "type": "string"
                }
              },
              "X-Server-Received-At": {
                "description": "Server UTC receipt timestamp. Response Date, when present, is generated by the HTTP server or proxy.",
                "schema": {
                  "format": "date-time",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Locked"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Read personal workspace preferences",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "description": "Atomically update self settings with the current ref_id from GET. Omitted groups and nested fields are preserved; null resets an entire supplied group to documented defaults. Nested scalar nulls and unknown keys are rejected with 422. Wrong-owner references return non-disclosing 404; stale references return 409 without applying changes. A no-op keeps the current reference. Returns a fresh reference after change. Locale supports en/fa, Gregorian calendar and valid IANA zones; settings never grant screen permissions.",
        "operationId": "apply_preferences_api_v1_me_preferences_patch",
        "parameters": [
          {
            "description": "Optional caller-controlled client software identifier for audit and diagnostics; captured up to 1024 characters. Browsers supply their own value and may ignore manual Swagger overrides. Not trusted client identity or authorization.",
            "in": "header",
            "name": "User-Agent",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional caller-controlled client software identifier for audit and diagnostics; captured up to 1024 characters. Browsers supply their own value and may ignore manual Swagger overrides. Not trusted client identity or authorization.",
              "examples": [
                "MyNativeClient/2.3",
                "python-httpx/0.28.1"
              ],
              "title": "User-Agent"
            }
          },
          {
            "description": "Optional RFC 9110 HTTP-date generated by native clients for advisory diagnostics. Browser JavaScript cannot set Date. Missing or invalid values do not reject the request.",
            "example": "Mon, 28 Sep 2026 12:00:00 GMT",
            "in": "header",
            "name": "Date",
            "required": false,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "description": "Optional preferred response language. English and Farsi are supported; regional tags use their base language and unsupported values fall back to English.",
            "example": "fa-IR",
            "in": "header",
            "name": "Accept-Language",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional UUIDv7 correlation identifier. Missing or invalid values are replaced with a generated UUIDv7; the effective value is returned in X-Request-ID.",
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional caller-supplied reason recorded in audit history. It is not an authorization credential.",
            "example": "Correcting a submitted request",
            "in": "header",
            "name": "X-Audit-Reason",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_PreferencesDTO_"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "Protected actor-specific response; persistent caching is prohibited.",
                "schema": {
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "X-Client-Date-Advisory": {
                "description": "Present as check-device-time only when the configured apparent difference threshold is reached.",
                "schema": {
                  "enum": [
                    "check-device-time"
                  ],
                  "type": "string"
                }
              },
              "X-Client-Date-Delta-Seconds": {
                "description": "Signed server receipt minus client Date in seconds; includes transit and generation delay, so it is not exact clock skew.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Client-Date-Status": {
                "description": "Optional client Date reading: available, unavailable, or invalid. No request is rejected for this diagnostic.",
                "schema": {
                  "enum": [
                    "available",
                    "unavailable",
                    "invalid"
                  ],
                  "type": "string"
                }
              },
              "X-Server-Received-At": {
                "description": "Server UTC receipt timestamp. Response Date, when present, is generated by the HTTP server or proxy.",
                "schema": {
                  "format": "date-time",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Locked"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Apply personal workspace preferences",
        "tags": [
          "me"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Localized failure with a stable application error number.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": false,
            "default": false,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "error",
          "code"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "SuccessResponse_PreferencesDTO_": {
        "properties": {
          "code": {
            "default": 200,
            "title": "Code",
            "type": "integer"
          },
          "data": {
            "$ref": "#/components/schemas/PreferencesDTO"
          },
          "error": {
            "title": "Error",
            "type": "null"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "success": {
            "const": true,
            "default": true,
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "data"
        ],
        "title": "SuccessResponse[PreferencesDTO]",
        "type": "object"
      },
      "PreferencesDTO": {
        "additionalProperties": false,
        "properties": {
          "appearance": {
            "$ref": "#/components/schemas/AppearancePreferences",
            "description": "Appearance settings."
          },
          "locale": {
            "$ref": "#/components/schemas/LocalePreferences",
            "description": "Language, timezone, calendar and display digits."
          },
          "notifications": {
            "$ref": "#/components/schemas/NotificationPreferences"
          },
          "ref_id": {
            "description": "Current self-owned optimistic reference; version zero represents unsaved defaults.",
            "title": "Ref Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "description": "Version of the typed personal settings contract.",
            "title": "Schema Version",
            "type": "integer"
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspacePreferences",
            "description": "Personal workspace defaults."
          }
        },
        "required": [
          "ref_id"
        ],
        "title": "PreferencesDTO",
        "type": "object"
      },
      "WorkspacePreferences": {
        "additionalProperties": false,
        "properties": {
          "landing_key": {
            "default": "requests",
            "description": "Allowlisted landing route key; a preference grants no screen permission.",
            "enum": [
              "requests",
              "work_items",
              "studio",
              "dashboard"
            ],
            "title": "Landing Key",
            "type": "string"
          },
          "page_size": {
            "default": 20,
            "description": "Default list page size, from 1 through 100 items.",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          }
        },
        "title": "WorkspacePreferences",
        "type": "object"
      },
      "NotificationPreferences": {
        "additionalProperties": false,
        "properties": {
          "email_enabled": {
            "default": false,
            "description": "Opt in to optional application email; mandatory security and approval notices remain enabled.",
            "title": "Email Enabled",
            "type": "boolean"
          }
        },
        "title": "NotificationPreferences",
        "type": "object"
      },
      "LocalePreferences": {
        "additionalProperties": false,
        "properties": {
          "calendar": {
            "const": "gregory",
            "default": "gregory",
            "description": "Gregorian calendar only; Persian language does not select a different calendar.",
            "title": "Calendar",
            "type": "string"
          },
          "language": {
            "default": "en",
            "description": "Preferred presentation language; canonical data stays unchanged.",
            "enum": [
              "en",
              "fa"
            ],
            "title": "Language",
            "type": "string"
          },
          "numbering": {
            "default": "latn",
            "description": "Preferred display digits; stored numbers keep their canonical format.",
            "enum": [
              "latn",
              "arabext"
            ],
            "title": "Numbering",
            "type": "string"
          },
          "timezone": {
            "default": "UTC",
            "description": "Valid IANA timezone for presentation; timestamps remain UTC.",
            "maxLength": 64,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          }
        },
        "title": "LocalePreferences",
        "type": "object"
      },
      "AppearancePreferences": {
        "additionalProperties": false,
        "properties": {
          "density": {
            "default": "comfortable",
            "description": "Workspace control density.",
            "enum": [
              "comfortable",
              "compact"
            ],
            "title": "Density",
            "type": "string"
          },
          "theme_key": {
            "default": "blue",
            "description": "Approved workspace palette key, shared with the frontend.",
            "enum": [
              "blue",
              "indigo",
              "violet",
              "emerald",
              "teal",
              "rose",
              "amber"
            ],
            "title": "Theme Key",
            "type": "string"
          },
          "theme_mode": {
            "default": "system",
            "description": "Appearance mode; system follows the device preference.",
            "enum": [
              "light",
              "dark",
              "system"
            ],
            "title": "Theme Mode",
            "type": "string"
          }
        },
        "title": "AppearancePreferences",
        "type": "object"
      },
      "PreferencesPatch": {
        "additionalProperties": false,
        "examples": [
          {
            "appearance": {
              "theme_mode": "dark"
            },
            "locale": {
              "language": "fa",
              "timezone": "Asia/Tehran"
            },
            "ref_id": "current-reference-from-read"
          }
        ],
        "properties": {
          "appearance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AppearancePreferences"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted preserves appearance; null resets this group; an object merges only supplied fields."
          },
          "locale": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LocalePreferences"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted preserves locale; null resets this group; an object merges only supplied fields."
          },
          "notifications": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NotificationPreferences"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted preserves notification preferences; null resets optional email to disabled."
          },
          "ref_id": {
            "description": "Expected reference from the latest preferences read; stale writes return a conflict.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Ref Id",
            "type": "string"
          },
          "workspace": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspacePreferences"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omitted preserves workspace; null resets this group; an object merges only supplied fields."
          }
        },
        "required": [
          "ref_id"
        ],
        "title": "PreferencesPatch",
        "type": "object"
      }
    }
  }
}
