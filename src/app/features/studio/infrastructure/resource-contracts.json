          },
          "data_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data Schema"
          },
          "behavior_dialect": {
            "anyOf": [
              { "type": "string", "const": "bpms.behavior/1" },
              { "type": "null" }
            ],
            "title": "Behavior Dialect"
          },
          "render_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Render Schema",
            "description": "Bounded bpms.render/1 document; POST /forms/render-schema returns its complete typed JSON Schema including messages, option_messages and bpms.format/1 field formatting. Message roles resolve to localized_text, localized_options and compatibility label/placeholder/accessibility fields in runtime views."
          },
          "page_settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Page Settings"
          },
          "variants": {
            "items": { "$ref": "#/components/schemas/FormDesignVariantDTO" },
            "type": "array",
            "maxItems": 32,
            "title": "Variants"
          },
          "reuse_instances": {
            "anyOf": [
              {
                "items": { "$ref": "#/components/schemas/ComponentUse" },
                "type": "array",
                "maxItems": 100
              },
              { "type": "null" }
            ],
            "title": "Reuse Instances",
            "description": "Exact authored component version references placed in empty render placeholders. Published versions pin fully resolved data/render snapshots and their transitive manifest."
          },
          "localization": {
            "anyOf": [
              { "$ref": "#/components/schemas/FormLocalization" },
              { "type": "null" }
            ],
            "description": "Optional bpms.messages/1 catalog pinned with this exact version. Null preserves legacy reads and checksums. Draft gaps are warnings; required translations and matching parameters are mandatory at publication."
          },
          "form_ref_id": { "type": "string", "title": "Form Ref Id" },
          "number": { "type": "integer", "minimum": 1, "title": "Number" }
        }
      },
      "update": {
        "required": ["data_schema", "render_schema"],
        "properties": {
          "data_dialect": {
            "type": "string",
            "title": "Data Dialect",
            "default": "https://json-schema.org/draft/2020-12/schema"
          },
          "render_dialect": {
            "type": "string",
            "title": "Render Dialect",
            "default": "bpms.render/1"
          },
          "data_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data Schema"
          },
          "behavior_dialect": {
            "anyOf": [
              { "type": "string", "const": "bpms.behavior/1" },
              { "type": "null" }
            ],
            "title": "Behavior Dialect"
          },
          "render_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Render Schema",
            "description": "Bounded bpms.render/1 document; POST /forms/render-schema returns its complete typed JSON Schema including messages, option_messages and bpms.format/1 field formatting. Message roles resolve to localized_text, localized_options and compatibility label/placeholder/accessibility fields in runtime views."
          },
          "page_settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Page Settings"
          },
          "variants": {
            "items": { "$ref": "#/components/schemas/FormDesignVariantDTO" },
            "type": "array",
            "maxItems": 32,
            "title": "Variants"
          },
          "reuse_instances": {
