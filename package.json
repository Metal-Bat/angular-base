{
  "name": "ng-architect",
  "version": "0.2.0",
  "scripts": {
    "ng": "env -u NO_COLOR nx",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "test:fonts": "node --test scripts/prepare-fonts.spec.mjs",
    "start": "node scripts/dev.mjs",
    "start:angular": "env -u NO_COLOR nx serve ng-architect",
    "build": "env -u NO_COLOR NG_BUILD_MAX_WORKERS=2 nx build ng-architect --output-style=static",
    "watch": "env -u NO_COLOR nx build ng-architect --watch --configuration development",
    "test": "env -u NO_COLOR nx test ng-architect",
    "prepare": "husky && pnpm run ui:prepare",
    "commit": "cz",
    "pretty-quick": "pretty-quick --staged",
    "lint": "env -u NO_COLOR nx lint ng-architect --output-style=static",
    "format": "prettier --write .",
    "release": "release-it",
    "lint:fix": "env -u NO_COLOR nx lint ng-architect --fix --output-style=static",
    "test:ci": "env -u NO_COLOR NG_BUILD_MAX_WORKERS=2 nx test ng-architect --watch=false --output-style=static",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:check": "node scripts/api-inventory.mjs --check && node scripts/check-platform-contract.mjs && node scripts/generate-api.mjs --check && node scripts/generate-authoring-contracts.mjs --check && node scripts/generate-studio-fixtures.mjs --check && node scripts/generate-admin-contracts.mjs --check && node scripts/generate-record-contracts.mjs --check && node scripts/generate-node-inspectors.mjs --check && node scripts/generate-preferences-contract.mjs --check && node scripts/generate-inbox-contract.mjs --check",
    "ci:gates": "node scripts/check-ci-gates.mjs",
    "dependencies:report": "node scripts/dependency-report.mjs",
    "test:boundary": "node server/session-boundary.spec.mjs && node --test server/http-boundary.spec.mjs && node server/inbox-stream.spec.mjs",
    "session:dev": "node server/main.mjs",
    "test:browser-boundary": "node server/browser-boundary.spec.mjs",
    "api:generate": "node scripts/generate-api.mjs && node scripts/generate-authoring-contracts.mjs && node scripts/generate-studio-fixtures.mjs && node scripts/generate-admin-contracts.mjs && node scripts/generate-record-contracts.mjs",
    "test:browser-auth": "node server/browser-auth.spec.mjs",
    "test:browser-ui": "node server/browser-ui.spec.mjs",
    "test:browser-workspace": "WORKSPACE_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "test:browser-backend": "node server/browser-backend.spec.mjs",
    "test:browser-canvas": "CANVAS_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "test:browser-studio": "node server/browser-studio.spec.mjs",
    "test:deployment": "node --test server/static-assets.spec.mjs",
    "test:browser-admin": "ADMIN_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "test:backend-admin": "node scripts/check-backend-operations.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "test:browser-performance": "PERFORMANCE_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "test:accessibility": "ACCESSIBILITY_CHECKS=1 pnpm run test:browser-ui && ACCESSIBILITY_CHECKS=1 pnpm run test:browser-admin",
    "test:deployment-https": "TLS_BROWSER_CHECKS=1 node server/browser-boundary.spec.mjs",
    "test:browser-quality": "node scripts/browser-quality-check.mjs",
    "test:browser-records": "RECORD_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "test:browser-catalogs": "STUDIO_CATALOG_BROWSER_CHECKS=1 node server/browser-auth.spec.mjs",
    "delivery:inventory": "node scripts/delivery-inventory.mjs",
    "delivery:check": "node scripts/delivery-inventory.mjs --check && node scripts/check-delivery-ui.mjs && node scripts/check-peer-contract.mjs && node scripts/check-help-catalog.mjs",
    "test:diagnostics": "node --test server/browser-diagnostics.spec.mjs server/browser-storage-policy.spec.mjs scripts/delivery-evidence.spec.mjs",
    "test:paired-smoke": "python3 scripts/paired-smoke.py",
    "delivery:status": "node scripts/delivery-status.mjs",
    "test:browser-sandbox": "node scripts/browser-sandbox.mjs",
    "ui:prepare": "node scripts/prepare-ant-design.mjs",
    "typecheck:playwright": "tsc --noEmit -p tsconfig.playwright.json",
    "lint:playwright": "eslint playwright.config.ts tests/playwright --max-warnings=0",
    "test:playwright": "env -u NO_COLOR PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/playwright playwright test --project=chromium --project=firefox",
    "test:playwright:webkit": "env -u NO_COLOR PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/playwright playwright test --project=webkit",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/playwright playwright install chromium firefox",
    "nx": "env -u NO_COLOR nx"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,js,cjs,mjs,yml,yaml}": "prettier --write"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@foblex/2d": "1.2.2",
    "@foblex/flow": "19.3.0",
    "@foblex/mediator": "1.1.3",
    "@foblex/platform": "1.0.4",
    "@foblex/utils": "1.1.1",
    "@primeuix/themes": "2.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "ng-zorro-antd": "21.3.3",
    "postcss": "8.5.28",
    "primeicons": "8.0.2",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.24",
    "@angular-devkit/schematics": "21.2.24",
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@playwright/test": "1.64.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@schematics/angular": "21.2.24",
    "@types/node": "26.6.4",
    "angular-eslint": "21.4.0",
    "axe-core": "4.13.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "nx": "24.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "release-it": "21.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "type": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            }
          ]
        }
      }
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.11.2 <13"
  },
  "packageManager": "pnpm@12.11.2"
}
